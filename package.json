{
  "name": "agentic-whiteboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "canvas:dev": "tsx canvas-service/index.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint . --max-warnings=0",
    "test": "vitest run",
    "test:ai": "AI_LIVE=1 vitest run lib/ai/live.test.ts",
    "test:db": "vitest run lib/workspace/board/listWorkspaceBoard.postgres.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:brand": "BRAND_SCREENSHOTS=1 playwright test e2e/brand-screenshots.spec.ts",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "test:e2e:realtime": "REALTIME_E2E=1 playwright test",
    "test:e2e:smtp": "node scripts/smtp-sink.mjs",
    "media:bucket": "node scripts/create-media-bucket.mjs",
    "db:up": "docker compose -f supabase-project/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f supabase-project/docker-compose.yml down",
    "db:mail": "docker compose -f supabase-project/docker-compose.yml --profile mail up -d --wait mail",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint:fix": "next typegen && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tsc": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.92",
    "@ai-sdk/react": "^4.0.177",
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.25",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@konopskidev/ui": "~0.6.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tldraw/sync": "5.6.2",
    "@tldraw/sync-core": "5.6.2",
    "@tldraw/tlschema": "5.6.2",
    "ai": "^7.0.173",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.24.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "tldraw": "5.6.2",
    "tw-animate-css": "^1.4.0",
    "ws": "8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/eslint-plugin": "~1.6.28",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0"
}
