{
  "name": "agentic-whiteboard",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm db:setup && pnpm --filter @v2/web test:e2e",
    "build": "pnpm -r build",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm db:migrate && pnpm db:seed && pnpm -r --parallel --filter=@v2/web --filter=@v2/agent --filter=@v2/collab dev",
    "start": "pnpm db:migrate && pnpm -r --parallel --filter=@v2/web --filter=@v2/agent --filter=@v2/collab start",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down -v",
    "db:generate": "pnpm --filter=@v2/db generate",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:migrate": "pnpm --filter=@v2/db migrate",
    "db:seed": "pnpm --filter=@v2/db seed"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
