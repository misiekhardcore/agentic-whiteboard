{
  "name": "@v2/collab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hocuspocus/server": "^4.9.0",
    "@v2/contracts": "workspace:*",
    "@v2/db": "workspace:*",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.9.0",
    "@types/node": "^26.6.6",
    "@v2/config": "workspace:*",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
