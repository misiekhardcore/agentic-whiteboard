# Copy to `.env` and adjust.
# v2 has its own database; `pnpm db:up` starts it on this port.
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/agentic_whiteboard_v2"

# Where the web app reaches the agent service, and where the agent listens.
AGENT_URL="http://127.0.0.1:3002"
AGENT_PORT="3002"

# The document room owner. It signs browser connection tokens with the same
# secret the app uses to call it, so both values must match.
DOC_SERVICE_SECRET="development-only-document-secret"
# The address a browser dials, and the address the app uses for health,
# snapshot and revoke calls.
DOC_SERVICE_URL="ws://localhost:3003"
DOC_SERVICE_INTERNAL_URL="http://127.0.0.1:3003"
DOC_PORT="3003"
# Optional: names this instance in a lease conflict. Defaults to hostname:pid.
# DOC_INSTANCE_ID="doc-1"
# Optional: how long a room lease stays live without a renewal. Defaults to 30.
# DOC_LEASE_SECONDS="30"

# The web app's own origin, used by scripts and (later) token minting.
WEB_URL="http://localhost:3000"
