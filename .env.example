# Copy this file to `.env` and replace the placeholders.
# Connection string for the self-hosted Supabase Postgres (supabase-project/).
# Start it with: npm run db:up
DATABASE_URL="postgresql://postgres:password@localhost:54322/agentic-whiteboard"

# Better Auth
# Signing/encryption secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Origin the app is served from, used for cookie and origin checks.
BETTER_AUTH_URL="http://localhost:3000"

# Optional: only needed if the auth client runs against a different origin.
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# SMTP for Better Auth's verification and password reset emails.
# The local Supabase mail profile catches them: `npm run db:mail`, then read
# them at http://localhost:9002.
SMTP_HOST="127.0.0.1"
SMTP_PORT="2500"
SMTP_FROM="Agentic Whiteboard <no-reply@localhost>"
# Only for a real SMTP server that requires a login.
# SMTP_USER=""
# SMTP_PASS=""

# Social sign-in. A provider is enabled only when both of its values are set.
# Register these authorized callback URLs with the provider:
#   http://localhost:3000/api/auth/callback/github
#   http://localhost:3000/api/auth/callback/google
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The agent's model. The app speaks the OpenAI chat-completions API and nothing
# else: whichever endpoint you point it at is the deployment's choice, and all
# three values are required. Local examples: LM Studio
# (http://127.0.0.1:1234/v1), Ollama (http://127.0.0.1:11434/v1),
# Groq (https://api.groq.com/openai/v1).
AI_BASE_URL=""
AI_API_KEY=""
# The exact model id: list them with `curl $AI_BASE_URL/models`.
AI_MODEL=""
# Optional. Defaults: 20 steps, 2 retries.
AI_MAX_STEPS=""
AI_MAX_RETRIES=""

# Naming a new conversation. Titles may run on a different endpoint than the
# agent; all three values are required and the request is sent once, in the
# background, after the conversation has its derived title.
# Groq with Qwen 3.8 27B is what this project uses:
#   TITLE_AI_BASE_URL="https://api.groq.com/openai/v1"
#   TITLE_AI_MODEL="qwen/qwen3.8-27b"
TITLE_AI_BASE_URL=""
TITLE_AI_API_KEY=""
TITLE_AI_MODEL=""
# Optional. Omit for models that think by themselves; set `none` to turn
# reasoning off on a provider that takes `reasoning_effort` (Groq, OpenAI).
TITLE_AI_REASONING_EFFORT="none"
# Optional. Signs tool-approval requests (archive, permanent delete) so a
# browser cannot approve an action it was never shown. At least 32 characters:
#   openssl rand -base64 32
# Until it is set, the approval-gated tools are not offered to the agent.
AI_TOOL_APPROVAL_SECRET=""

# Realtime change events, from supabase-project/ (see its README):
# `npm run db:up` exposes the gateway on :8000. Copy the four values below from
# supabase-project/.env, adding the NEXT_PUBLIC_ prefix on the browser pair.
#
# The browser pair is the legacy anon JWT, not `sb_publishable_…`: the gateway
# translates the opaque key into an ES256 token, and Realtime only verifies
# HS256 tokens signed with `JWT_SECRET`.
SUPABASE_URL="http://localhost:8000"
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL="http://localhost:8000"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# The stack's `JWT_SECRET`. The app signs the browser's short-lived Realtime
# token with it, so Realtime accepts the socket.
JWT_SECRET=""

# Stripe billing. Use test-mode keys while developing.
# Secret key and publishable key: Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Signing secret for the webhook endpoint at /api/billing/webhook. A deployed
# endpoint needs it. Locally, leave it unset and forward events with the Stripe
# CLI: `stripe listen --forward-to localhost:3000/api/billing/webhook`.
# Outside production the route accepts unsigned events, but only when this is
# empty; with it set every request must be signed.
STRIPE_WEBHOOK_SECRET=""
# Plan prices live in lib/billing/plans.ts, so no Stripe price ids are needed.
# `pnpm test:e2e` uses these keys too: it buys Pro in test mode and checks the
# webhook result, so run `stripe listen` (see above) while it runs.
