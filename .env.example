# Copy this file to `.env` and replace the placeholders.
# Connection string for the self-hosted Supabase Postgres (supabase-project/).
# Start it with: npm run db:up
DATABASE_URL="postgresql://postgres:password@localhost:54322/agentic-whiteboard"

# Better Auth
# Signing/encryption secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Origin the app is served from, used for cookie and origin checks.
BETTER_AUTH_URL="http://localhost:3000"

# Optional: only needed if the auth client runs against a different origin.
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# SMTP for Better Auth's verification and password reset emails.
# The local Supabase mail profile catches them: `npm run db:mail`, then read
# them at http://localhost:9002.
SMTP_HOST="127.0.0.1"
SMTP_PORT="2500"
SMTP_FROM="Agentic Whiteboard <no-reply@localhost>"
# Only for a real SMTP server that requires a login.
# SMTP_USER=""
# SMTP_PASS=""

# Social sign-in. A provider is enabled only when both of its values are set.
# Register these authorized callback URLs with the provider:
#   http://localhost:3000/api/auth/callback/github
#   http://localhost:3000/api/auth/callback/google
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI / LLM provider. The app talks to any OpenAI-compatible endpoint;
# LM Studio is the default for local development.
# Start LM Studio's server, then list the model ids it has loaded:
#   curl http://127.0.0.1:1234/v1/models
# AI_PROVIDER: lmstudio | openai-compatible
AI_PROVIDER="lmstudio"
# The exact id printed by /v1/models. Required.
AI_MODEL=""
# Defaults to http://127.0.0.1:1234/v1 for lmstudio; required otherwise.
# For Ollama, for example: http://127.0.0.1:11434/v1
AI_BASE_URL=""
# LM Studio ignores this; hosted compatible APIs require it.
AI_API_KEY=""
# Optional. Defaults: 20 steps, 0 retries for lmstudio, 2 otherwise.
AI_MAX_STEPS=""
AI_MAX_RETRIES=""

# Stripe billing. Use test-mode keys while developing.
# Secret key and publishable key: Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Signing secret for the webhook endpoint at /api/billing/webhook. A deployed
# endpoint needs it. Locally, leave it unset and forward events with the Stripe
# CLI: `stripe listen --forward-to localhost:3000/api/billing/webhook`.
# Outside production the route accepts unsigned events, but only when this is
# empty; with it set every request must be signed.
STRIPE_WEBHOOK_SECRET=""
# Plan prices live in lib/billing/plans.ts, so no Stripe price ids are needed.
# `pnpm test:e2e` uses these keys too: it buys Pro in test mode and checks the
# webhook result, so run `stripe listen` (see above) while it runs.
