# Copy this file to `.env` and replace the placeholders.
# Connection string for the self-hosted Supabase Postgres (supabase-project/).
# Start it with: npm run db:up
DATABASE_URL="postgresql://postgres:password@localhost:54322/agentic-whiteboard"

# Better Auth
# Signing/encryption secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Origin the app is served from, used for cookie and origin checks.
BETTER_AUTH_URL="http://localhost:3000"

# Optional: only needed if the auth client runs against a different origin.
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# SMTP for Better Auth's verification and password reset emails.
# The local Supabase mail profile catches them: `npm run db:mail`, then read
# them at http://localhost:9002.
SMTP_HOST="127.0.0.1"
SMTP_PORT="2500"
SMTP_FROM="Agentic Whiteboard <no-reply@localhost>"
# Only for a real SMTP server that requires a login.
# SMTP_USER=""
# SMTP_PASS=""

# Social sign-in. A provider is enabled only when both of its values are set.
# Register these authorized callback URLs with the provider:
#   http://localhost:3000/api/auth/callback/github
#   http://localhost:3000/api/auth/callback/google
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe integration secrets for billing
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=