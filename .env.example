# Copy to `.env` and adjust. Every process also reads `.env.<NODE_ENV>`,
# `.env.local` and `.env.<NODE_ENV>.local` from the repository root, with that
# precedence (`.env` lowest) and variables the environment already exports
# winning over every file. `.env.local` is the machine's own copy.
# v2 has its own database; `pnpm db:up` starts it on this port.
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/agentic_whiteboard_v2"

# Where the web app reaches the agent service, and where the agent listens.
AGENT_URL="http://127.0.0.1:3002"
AGENT_PORT="3002"

# The document room owner. It signs browser connection tokens with the same
# secret the app uses to call it, so both values must match.
DOC_SERVICE_SECRET="development-only-document-secret"
# The address a browser dials, and the address the app uses for health,
# snapshot and revoke calls.
DOC_SERVICE_URL="ws://localhost:3003"
DOC_SERVICE_INTERNAL_URL="http://127.0.0.1:3003"
DOC_PORT="3003"
# Optional: names this instance in a lease conflict. Defaults to hostname:pid.
# DOC_INSTANCE_ID="doc-1"
# Optional: how long a room lease stays live without a renewal. Defaults to 30.
# DOC_LEASE_SECONDS="30"

# The web app's own origin, used by scripts, token minting and the auth
# callbacks. Register `<origin>/api/auth/callback/<provider>` with a provider.
WEB_URL="http://localhost:3000"

# Signing and encryption secret for sessions and reset tokens. Required by a
# deployment; generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Social sign-in. A provider appears on the sign-in page only when both of its
# values are set.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Identity mail (reset links and invitations). v2 has no SMTP transport yet:
# development prints the link to the server log, production refuses to log a
# credential and drops the message. Set `log` to opt into logging in
# production on a throwaway deployment.
# IDENTITY_MAIL_MODE=""
