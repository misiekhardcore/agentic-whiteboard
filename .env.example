# Copy this file to `.env` and replace the placeholders.
# Connection string for the self-hosted Supabase Postgres (supabase-project/).
# Start it with: npm run db:up
DATABASE_URL="postgresql://postgres:password@localhost:54322/agentic-whiteboard"

# Better Auth
# Signing/encryption secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Origin the app is served from, used for cookie and origin checks.
BETTER_AUTH_URL="http://localhost:3000"

# Optional: only needed if the auth client runs against a different origin.
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# SMTP for Better Auth's verification and password reset emails.
# The local Supabase mail profile catches them: `npm run db:mail`, then read
# them at http://localhost:9002.
SMTP_HOST="127.0.0.1"
SMTP_PORT="2500"
SMTP_FROM="Agentic Whiteboard <no-reply@localhost>"
# Only for a real SMTP server that requires a login.
# SMTP_USER=""
# SMTP_PASS=""

# Social sign-in. A provider is enabled only when both of its values are set.
# Register these authorized callback URLs with the provider:
#   http://localhost:3000/api/auth/callback/github
#   http://localhost:3000/api/auth/callback/google
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The agent's model. Any OpenAI-compatible endpoint works (LM Studio, Ollama,
# vLLM, Groq, OpenRouter, ...); the app knows nothing about providers and has
# no defaults, so every value below is required.
# List a local server's model ids with: curl http://127.0.0.1:1234/v1/models
AI_MODEL=""
# Base URL including the version segment, e.g. http://127.0.0.1:1234/v1
AI_BASE_URL=""
# Sent as a bearer token. Local servers that ignore auth still need a value;
# hosted endpoints require the real key (Groq: https://console.groq.com/keys).
AI_API_KEY=""
# "1" answers with the scripted provider instead of calling a model (e2e only).
AI_STUB="0"
# The agentic tool loop's step limit and the client's retry count.
AI_MAX_STEPS="20"
AI_MAX_RETRIES="0"
# Conversation names use their own endpoint, so a small hosted model can label
# threads while the agent runs locally. It is sent reasoning_effort "none": a
# name must answer rather than deliberate. All three are required.
AI_TITLE_BASE_URL=""
AI_TITLE_API_KEY=""
AI_TITLE_MODEL=""

# Optional. Signs tool-approval requests (archive, permanent delete) so a
# browser cannot approve an action it was never shown. At least 32 characters:
#   openssl rand -base64 32
# Until it is set, the approval-gated tools are not offered to the agent.
AI_TOOL_APPROVAL_SECRET=""

# Stripe billing. Use test-mode keys while developing.
# Secret key and publishable key: Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Signing secret for the webhook endpoint at /api/billing/webhook. A deployed
# endpoint needs it. Locally, leave it unset and forward events with the Stripe
# CLI: `stripe listen --forward-to localhost:3000/api/billing/webhook`.
# Outside production the route accepts unsigned events, but only when this is
# empty; with it set every request must be signed.
STRIPE_WEBHOOK_SECRET=""
# Plan prices live in lib/billing/plans.ts, so no Stripe price ids are needed.
# `pnpm test:e2e` uses these keys too: it buys Pro in test mode and checks the
# webhook result, so run `stripe listen` (see above) while it runs.
